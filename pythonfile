@app.route('/clientes_page')
def clientes_page():
    # 1. Pega o número da página atual da URL (padrão é 1 se não houver)
    page = request.args.get('page', 1, type=int)
    per_page = 10  # Define o limite de 10 clientes por tela
    offset = (page - 1) * per_page

    conn = get_db_connection()
    
    # 2. Busca apenas os 10 clientes daquela página
    clientes = conn.execute('SELECT * FROM cliente ORDER BY nome ASC LIMIT ? OFFSET ?', 
                            (per_page, offset)).fetchall()
    
    # 3. Conta quantos clientes existem no total para calcular as páginas
    total = conn.execute('SELECT COUNT(*) FROM cliente').fetchone()[0]
    total_pages = (total + per_page - 1) // per_page

    conn.close()
    
    # 4. ENVIA AS VARIÁVEIS 'page' e 'total_pages' PARA O HTML
    return render_template('cliente.html', 
                           clientes=clientes, 
                           page=page, 
                           total_pages=total_pages)

