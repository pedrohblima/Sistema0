@app.route('/financeiro')
def financeiro():
    # 1. ADICIONADO: Captura as datas vindas do filtro HTML
    data_inicio = request.args.get('data_inicio')
    data_fim = request.args.get('data_fim')
    
    page = request.args.get('page', 1, type=int)
    per_page = 10
    offset = (page - 1) * per_page

    conn = get_db_connection()

    # 2. ADICIONADO: Lógica de filtro para somas e para a tabela
    filtro_sql = ""
    params = []
    if data_inicio and data_fim:
        filtro_sql = " WHERE dt_vencimento BETWEEN ? AND ?"
        params = [data_inicio, data_fim]

    # 3. ADICIONADO: Cálculos para os cards (evita o erro de Undefined)
    # Soma entradas e saídas no período selecionado
    total_recebido = conn.execute(f"SELECT SUM(valor) FROM contas_a_receber {filtro_sql.replace('WHERE', 'WHERE status = \"PAGO\" AND') if filtro_sql else 'WHERE status = \"PAGO\"'}", params).fetchone()[0] or 0
    total_pago = conn.execute(f"SELECT SUM(valor) FROM contas_a_Pagar {filtro_sql.replace('WHERE', 'WHERE status = \"PAGO\" AND') if filtro_sql else 'WHERE status = \"PAGO\"'}", params).fetchone()[0] or 0
    saldo_caixa = total_recebido - total_pago
    
    # 4. ALTERADO: Query da tabela para também respeitar o filtro
    contas = conn.execute(f'''
        SELECT id_contaP, nome_custo, valor, dt_vencimento, status 
        FROM contas_a_Pagar 
        {filtro_sql}
        ORDER BY status DESC, dt_vencimento ASC 
        LIMIT ? OFFSET ?
    ''', params + [per_page, offset]).fetchall()

    # Ajuste na contagem total para paginação com filtro
    total = conn.execute(f'SELECT COUNT(*) FROM contas_a_Pagar {filtro_sql}', params).fetchone()[0]
    total_pages = (total + per_page - 1) // per_page
    
    conn.close()
    
    # 5. ALTERADO: Return enviando as novas variáveis para o HTML
    return render_template('financeiro_menu.html', 
                           contas=contas, 
                           page=page, 
                           total_pages=total_pages,
                           total_recebido=total_recebido,
                           total_pago=total_pago,
                           saldo_caixa=saldo_caixa,
                           data_inicio=data_inicio,
                           data_fim=data_fim)


