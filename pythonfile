@app.route('/salvar_pagamento', methods=['POST'])
def salvar_pagamento():
    # Coleta os dados enviados pelo formulário HTML
    categoria = request.form.get('categoria')
    nome_custo = request.form.get('nome_custo')
    
    # Tratamento de moeda: Remove o ponto de milhar e troca a vírgula pelo ponto decimal
    valor_raw = request.form.get('valor')
    valor = float(valor_raw.replace('.', '').replace(',', '.'))
    
    num_doc = request.form.get('num_doc')
    # Captura a condição de pagamento (Ex: 1x, Mensal) para a coluna obrigatória do banco
    condicao = request.form.get('condicao_pagamento') 
    dt_vencimento = request.form.get('dt_vencimento')

    conn = get_db_connection()
    
    # Executa o INSERT garantindo que o nome da coluna 'Condição_pagamento' esteja correto
    conn.execute('''
        INSERT INTO contas_a_Pagar (
            categoria, 
            nome_custo, 
            valor, 
            num_doc, 
            Condição_pagamento, 
            dt_vencimento, 
            status
        )
        VALUES (?, ?, ?, ?, ?, ?, 'PENDENTE')
    ''', (categoria, nome_custo, valor, num_doc, condicao, dt_vencimento))
    
    conn.commit()
    conn.close()
    
    # Redireciona de volta para a listagem de contas a pagar
    return redirect('/contas_pagar')


