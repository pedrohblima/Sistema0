@app.route('/produtos')
def produtos():
    page = request.args.get('page', 1, type=int)
    per_page = 10
    offset = (page - 1) * per_page

    categoria_sel = (request.args.get('categoria') or '').strip()

    conn = get_db_connection()

    where_sql = ""
    params_count = []
    params_list = []

    if categoria_sel:
        where_sql = "WHERE categoria = ?"
        params_count = [categoria_sel]
        params_list = [categoria_sel, per_page, offset]
    else:
        params_list = [per_page, offset]

    total_row = conn.execute(
        f"SELECT COUNT(*) AS total FROM produto {where_sql}",
        params_count
    ).fetchone()
    total_registros = (total_row["total"] if total_row and total_row["total"] is not None else 0)

    produtos = conn.execute(
        f"""
