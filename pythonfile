        recebido = conn.execute(f"SELECT SUM(valor) FROM contas_a_receber WHERE status IN ('PAGO', 'RECEBIDO') {filtro}", params).fetchone()[0] or 0
        pago = conn.execute(f"SELECT SUM(valor) FROM contas_a_Pagar WHERE status IN ('PAGO', 'BAIXADO') {filtro}", params).fetchone()[0] or 0
