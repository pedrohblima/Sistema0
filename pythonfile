@app.route('/vendas')
def vendas():
    page = request.args.get('page', 1, type=int)
    per_page = 10
    offset = (page - 1) * per_page

    # filtros (GET)
    nfe_busca = (request.args.get('nfe') or '').strip()
    mes_busca = (request.args.get('mes') or '').strip()  # formato YYYY-MM

    conn = get_db_connection()

    # combos do form (mantive os seus)
    c = conn.execute('SELECT id_cliente, nome FROM cliente ORDER BY nome ASC').fetchall()
    p = conn.execute(
        "SELECT id_produto, (categoria || ' ' || modelo) as nome_completo, marca FROM produto"
    ).fetchall()

    where_sql = ""
    params_where = []

    # Prioridade: se nfe foi preenchida, filtra por nfe. Senão, filtra por mês.
    if nfe_busca:
        where_sql = "WHERE CAST(v.nfe AS TEXT) LIKE ?"
        params_where = [f"%{nfe_busca}%"]
    elif mes_busca:
        # funciona se datavenda estiver 'YYYY-MM-DD'
        where_sql = "WHERE substr(v.datavenda, 1, 7) = ?"
        params_where = [mes_busca]

    # 1) Consulta principal paginada
    h = conn.execute(f'''
        SELECT
            v.nfe,
            v.datavenda,
            c.nome as nome_cliente,
            GROUP_CONCAT(p.categoria || ' ' || p.modelo, ' + ') as nome_produto,
            SUM(v.quantidade) as total_qtd,
            SUM(v.total) as total_geral,
            v.forma_pagto,
            v.arquivo_nfe
        FROM vendas v
        JOIN cliente c ON v.id_cliente = c.id_cliente
        JOIN produto p ON v.id_produto = p.id_produto
        {where_sql}
        GROUP BY v.nfe, v.datavenda, c.nome, v.forma_pagto
        ORDER BY v.datavenda DESC, v.nfe DESC
        LIMIT ? OFFSET ?
    ''', (*params_where, per_page, offset)).fetchall()

    # 2) Total de NFEs (distintas) respeitando o filtro
    total_nfes = conn.execute(f'''
        SELECT COUNT(DISTINCT v.nfe)
        FROM vendas v
        {where_sql}
    ''', params_where).fetchone()[0] or 0

    total_pages = max(1, (total_nfes + per_page - 1) // per_page)

    conn.close()

    return render_template(
        'vendas.html',
        clientes=c,
        produtos=p,
        vendas=h,
        page=page,
        total_pages=total_pages,
        nfe=nfe_busca,
        mes=mes_busca,
        total_nfes=total_nfes
    )

@app.route('/salvar_venda', methods=['POST'])
def salvar_venda():
    nfe = request.form.get('nfe')
    
    conn = get_db_connection()
    
    # --- TRAVA DE SEGURANÇA: Verifica se a NFE já existe ---
    venda_existente = conn.execute('SELECT nfe FROM vendas WHERE nfe = ?', (nfe,)).fetchone()
    if venda_existente:
        conn.close()
        return f"""
        <script>
            alert('⚠️ ERRO: A NFE {nfe} já está cadastrada!');
            window.location.href = '/vendas';
        </script>
        """
    # ---------------------------------------------------------------------------------------------------

    data_venda_str = request.form.get('datavenda')
    id_cliente = request.form.get('id_cliente')
    forma_pagto_original = request.form.get('forma_pagto', '0')
    forma_pagto_limpa = forma_pagto_original.lower().replace('dias', '').strip()
    
    produtos_ids = request.form.getlist('id_produto[]')
    quantidades = request.form.getlist('quantidade[]')
    valores_un_raw = request.form.getlist('valorproduto[]')
    
    total_geral_nfe = 0
    
    try:
        # 1. LOOP DE ITENS: Salva os produtos individualmente na tabela Vendas
        for i in range(len(produtos_ids)):
            if not produtos_ids[i]: continue 
            
            v_un = float(valores_un_raw[i].replace('.', '').replace(',', '.'))
            qtd = float(quantidades[i])
            subtotal_item = v_un * qtd
            total_geral_nfe += subtotal_item  # Soma o valor total da nota fiscal

            conn.execute("""
                INSERT INTO vendas (nfe, datavenda, id_cliente, id_produto, quantidade, valorproduto, total, forma_pagto)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            """, (nfe, data_venda_str, id_cliente, produtos_ids[i], qtd, v_un, subtotal_item, forma_pagto_original))

        # 2. LANÇAMENTO FINANCEIRO ÚNICO (Fora do loop de itens)
        termos_a_vista = ['a vista', 'avista', 'pix', 'dinheiro', 'debito', 'débito', '0']
        
        if forma_pagto_limpa in termos_a_vista:
            conn.execute("""
                INSERT INTO contas_a_Receber (id_cliente, valor, num_doc, dt_vencimento, dt_pagto, status)
                VALUES (?, ?, ?, ?, ?, 'PAGO')
            """, (id_cliente, total_geral_nfe, f"{nfe} (À VISTA)", data_venda_str, data_venda_str))
        else:
            prazos = forma_pagto_limpa.split('/')
            valor_parcela = round(total_geral_nfe / len(prazos), 2)
            data_venda_dt = datetime.strptime(data_venda_str, '%Y-%m-%d')
            
            for i, dias in enumerate(prazos):
                vencimento = data_venda_dt + timedelta(days=int(dias.strip()))
                conn.execute("""
                    INSERT INTO contas_a_Receber (id_cliente, valor, num_doc, dt_vencimento, status)
                    VALUES (?, ?, ?, ?, 'PENDENTE')
                """, (id_cliente, valor_parcela, f"{nfe} ({i+1}/{len(prazos)})", vencimento.strftime('%Y-%m-%d')))
        
        conn.commit()
    except Exception as e:
        if conn: conn.rollback()
        return f"<h1>Erro ao salvar:</h1><p>{e}</p>"
    finally:
        conn.close()
    return redirect('/vendas')

@app.route('/upload_nfe/<nfe>', methods=['POST'])
def upload_nfe(nfe):
    if 'file' not in request.files: return redirect('/vendas')
    file = request.files['file']
    if file and file.filename != '':
        filename = secure_filename(f"NF_{nfe}_{file.filename.replace(' ', '_')}")
        file.save(os.path.join(app.config['UPLOAD_FOLDER'], filename))
        
        conn = get_db_connection()
        conn.execute("UPDATE vendas SET arquivo_nfe = ? WHERE nfe = ?", (filename, nfe))
        conn.commit()
        conn.close()
    return redirect('/vendas')

