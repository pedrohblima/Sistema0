    total_pagos = conn.execute("SELECT COUNT(*) FROM contas_a_Pagar WHERE status = 'PAGO'").fetchone()[0]
    total_pages = max(1, (total_pagos + per_page - 1) // per_page)
    
    conn.close()
    
    # Você pode criar um HTML novo (historico_pagos.html) ou reutilizar o atual com uma trava
    return render_template('historico_pagos.html', contas=contas_pagas, page=page, total_pages=total_pages)


