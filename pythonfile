# --- DASHBOARD DE FATURAMENTO (INSIGHTS) ---
@app.route('/faturamento', methods=['GET', 'POST'])
def faturamento():
    conn = get_db_connection()
    data_inicio = request.form.get('data_inicio')
    data_fim = request.form.get('data_fim')
    total_periodo = 0

    if data_inicio and data_fim:
        resultado = conn.execute('''
            SELECT SUM(total) as total 
            FROM vendas 
            WHERE datavenda BETWEEN ? AND ?
        ''', (data_inicio, data_fim)).fetchone()
        total_periodo = resultado['total'] if resultado['total'] else 0

    recebido = conn.execute("SELECT SUM(valor) FROM contas_a_Receber WHERE status = 'PAGO'").fetchone()[0] or 0
    pago = conn.execute("SELECT SUM(valor) FROM contas_a_Pagar WHERE status = 'PAGO'").fetchone()[0] or 0
    pendente_r = conn.execute("SELECT SUM(valor) FROM contas_a_Receber WHERE status = 'PENDENTE'").fetchone()[0] or 0
    pendente_p = conn.execute("SELECT SUM(valor) FROM contas_a_Pagar WHERE status = 'PENDENTE'").fetchone()[0] or 0
    
    saldo = recebido - pago

    vendas_list = conn.execute('SELECT num_doc, valor FROM contas_a_Receber WHERE status = "PAGO" ORDER BY id_contaR DESC LIMIT 5').fetchall()
    gastos_list = conn.execute('SELECT nome_custo, valor FROM contas_a_Pagar WHERE status = "PAGO" ORDER BY id_contaP DESC LIMIT 5').fetchall()

    conn.close()
    return render_template('faturamento.html', 
                           total_periodo=total_periodo, inicio=data_inicio, fim=data_fim,
                           recebido=recebido, pago=pago, saldo=saldo,
                           pendente_r=pendente_r, pendente_p=pendente_p,
                           vendas=vendas_list, gastos=gastos_list)
