@app.route('/vendas_insights')
def vendas_insights():
    conn = get_db_connection()
    
    # 1. Produtos que mais vendem (Quantidade bruta)
    ranking_produtos = conn.execute('''
        SELECT p.categoria || ' ' || p.modelo as produto, SUM(v.quantidade) as total_qtd
        FROM vendas v
        JOIN produto p ON v.id_produto = p.id_produto
        GROUP BY produto
        ORDER BY total_qtd DESC LIMIT 10
    ''').fetchall()

    # 2. Clientes "VIP" (Quem mais gastou dinheiro)
    ranking_clientes = conn.execute('''
        SELECT c.nome, SUM(v.total) as total_gasto
        FROM vendas v
        JOIN cliente c ON v.id_cliente = c.id_cliente
        GROUP BY c.nome
        ORDER BY total_gasto DESC LIMIT 10
    ''').fetchall()

    # 3. Clientes Mais Fiéis (Quem mais vezes fez pedidos - frequência)
    ranking_fidelidade = conn.execute('''
        SELECT c.nome, COUNT(DISTINCT v.nfe) as total_pedidos
        FROM vendas v
        JOIN cliente c ON v.id_cliente = c.id_cliente
        GROUP BY c.nome
        ORDER BY total_pedidos DESC LIMIT 10
    ''').fetchall()

    conn.close()
    return render_template('vendas_insights.html', 
                           produtos=ranking_produtos, 
                           clientes=ranking_clientes, 
                           fidelidade=ranking_fidelidade)
