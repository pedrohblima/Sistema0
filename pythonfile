@app.route('/clientes_page')
def clientes_page():
    page = request.args.get('page', 1, type=int)
    per_page = 10
    offset = (page - 1) * per_page

    cnpj_busca = (request.args.get('cnpj') or '').strip()
    cnpj_norm = re.sub(r'\D', '', cnpj_busca)

    conn = get_db_connection()

    base_where = ""
    params_count = []
    params_list = []

    if cnpj_norm:
        base_where = """
            WHERE REPLACE(REPLACE(REPLACE(cnpj_cpf, '.', ''), '-', ''), '/', '') LIKE ?
        """
        like = f"%{cnpj_norm}%"
        params_count = [like]
        params_list = [like, per_page, offset]
    else:
        params_list = [per_page, offset]

    total_row = conn.execute(
        f"SELECT COUNT(*) AS total FROM cliente {base_where}",
        params_count
    ).fetchone()

    total_registros = (total_row["total"] if total_row and total_row["total"] is not None else 0)

    # ✅ Mensagem quando buscar e não achar (mostra só na página 1 pra não “spammar”)
    if cnpj_norm and total_registros == 0 and page == 1:
        flash("CPF/CNPJ não localizado", "error")

    clientes = conn.execute(
        f"""
        SELECT *
        FROM cliente
        {base_where}
        ORDER BY id_cliente DESC
        LIMIT ? OFFSET ?
        """,
        params_list
    ).fetchall()

    conn.close()

    total_pages = max(1, (total_registros + per_page - 1) // per_page)

    return render_template(
        'cliente.html',
        clientes=clientes,
        page=page,
        total_pages=total_pages,
        cnpj=cnpj_busca
    )



@app.route('/cadastrar_cliente', methods=['POST'])
def cadastrar_cliente():
    nome = (request.form.get('nome') or '').strip()
    doc_raw = (request.form.get('cnpj_cpf') or '').strip()

    # Normaliza só para checagem (remove . / - espaços etc)
    doc_norm = re.sub(r'\D', '', doc_raw)

    if not doc_norm:
        flash('CNPJ/CPF inválido.', 'error')
        return redirect(url_for('clientes_page'))

    conn = get_db_connection()

    # Checa duplicidade mesmo se o que está no banco estiver formatado
    existe = conn.execute("""
        SELECT 1
        FROM cliente
        WHERE REPLACE(REPLACE(REPLACE(cnpj_cpf, '.', ''), '-', ''), '/', '') = ?
        LIMIT 1
    """, (doc_norm,)).fetchone()

    if existe:
        conn.close()
        flash('CNPJ/CPF já existente', 'error')
        return redirect(url_for('clientes_page'))

    dados = (
        nome,
        doc_raw,  # mantém no formato que o usuário digitou (com máscara)
        request.form.get('ie'),
        request.form.get('cep'),
        request.form.get('rua'),
        request.form.get('cidade'),
        request.form.get('estado')
    )

    conn.execute('INSERT INTO cliente VALUES (NULL, ?, ?, ?, ?, ?, ?, ?)', dados)
    conn.commit()
    conn.close()

    flash('Cliente cadastrado com sucesso!', 'success')
    return redirect(url_for('clientes_page'))


