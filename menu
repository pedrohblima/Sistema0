<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu</title>
    <style>
        :root {
            --primary: #2c3e50;
            --accent: #2ecc71;
            --bg-overlay: rgba(0, 0, 0, 0.65);
        }

        body, html { height: 100%; margin: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; overflow: hidden; }

        /* TELA DE FUNDO EXECUTIVA */
        .hero-bg {
            background-image: url('https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&q=80&w=2070'); 
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .hero-bg::before {
            content: "";
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: var(--bg-overlay);
            z-index: 1;
        }

        .container { 
            position: relative; 
            z-index: 2; 
            text-align: center; 
            padding: 20px; 
            width: 100%;
            max-width: 1200px;
        }

        h1 { color: white; font-size: 3.5rem; margin-bottom: 10px; font-weight: 800; letter-spacing: -1px; text-shadow: 2px 2px 10px rgba(0,0,0,0.5); }
        .subtitle { color: rgba(255, 255, 255, 0.8); font-size: 1.2rem; margin-bottom: 50px; }

        /* GRID LADO A LADO IGUAL AO FINANCEIRO */
        .menu-cards { 
            display: grid; 
            grid-template-columns: repeat(4, 1fr); 
            gap: 20px; 
            margin: auto; 
        }

        /* ESTILO VIDRO (GLASSMORPHISM) */
        .card { 
            background: rgba(255, 255, 255, 0.1) !important; 
            backdrop-filter: blur(15px);
            padding: 40px 20px; 
            border-radius: 20px; 
            box-shadow: 0 8px 32px rgba(0,0,0,0.3); 
            text-decoration: none; 
            color: white !important; 
            transition: all 0.3s ease; 
            border: 1px solid rgba(255, 255, 255, 0.2) !important;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
        }

        /* HOVER PREMIUM */
        .card:hover { 
            transform: translateY(-10px); 
            background: rgba(255, 255, 255, 0.2) !important; 
            box-shadow: 0 15px 45px rgba(0, 0, 0, 0.4);
            border-bottom: 5px solid var(--accent) !important;
        }

        .card h2 { margin: 0; font-size: 1.5rem; color: white !important; transition: 0.3s; }
        .card p { margin: 0; font-size: 0.85rem; color: rgba(255, 255, 255, 0.7) !important; font-weight: 500; }
        .card span { font-size: 40px; margin-bottom: 5px; }

        /* Cores no Hover por categoria */
        .card-clientes:hover { border-bottom-color: #2ecc71 !important; }
        .card-produtos:hover { border-bottom-color: #3498db !important; }
        .card-venda:hover { border-bottom-color: #f1c40f !important; }
        .card-financeiro:hover { border-bottom-color: #e74c3c !important; }

        .stats { margin-top: 60px; color: rgba(255,255,255,0.4); font-size: 0.8rem; letter-spacing: 2px; font-weight: bold; }
    </style>
</head>
<body>

<div class="hero-bg">
    <div class="container">
        <h1>MasterLoja</h1>
        <p class="subtitle">Gestão Inteligente de Faturamento para Empresas</p>
        
        <div class="menu-cards">
            <a href="/clientes_page" class="card card-clientes">
    <span>👥</span>
    <h2>Clientes</h2>
    <p>Carteira de Clientes Ativos</p>
            </a>    
            <a href="/produtos" class="card card-produtos">
                <span>📦</span>
                <h2>Produtos</h2>
                <p>Central de Produtos e Modelos</p>
            </a>
            <a href="/vendas" class="card card-venda">
                <span>🛒</span>
                <h2>Vendas</h2>
                <p>Painel de Operações de Venda</p>
            </a>
            <a href="/financeiro" class="card card-financeiro">
                <span>💰</span>
                <h2>Financeiro</h2>
                <p>Gestão de Fluxo de Caixa e Capital</p>
            </a>
        </div>

        <div class="stats">
            SISTEMA OPERACIONAL | VERSÃO 1.0 PRO | 2026
        </div>
    </div>
</div>

</body>
</html>
